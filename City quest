let s=JSON.parse(localStorage.getItem("cq02")||'{"mission":0,"xp":0,"secrets":0,"paid":false}');
let user=null,map=null,userMarker=null;
const app=document.getElementById("app");
const save=()=>localStorage.setItem("cq02",JSON.stringify(s));
function shell(c){app.innerHTML=`<main class="shell"><div class="top"><div class="brand">CITY QUEST</div><div class="xp">${s.xp} XP</div></div>${c}<div class="footer">MVP v0.2 · Координаты маршрута требуют полевой проверки перед запуском</div></main>`}
function home(){shell(`<section class="hero"><div class="eyebrow">Первая охота</div><h1>Тайны<br>старой Москвы</h1><p>Пеший квест по историческому центру: карта, GPS, истории, загадки и XP.</p><div class="card"><div class="cover"></div><div class="meta"><span class="pill">🚶 ~4 км</span><span class="pill">⏱ 1,5–2 часа</span><span class="pill">🔎 10 миссий</span></div><button class="primary" onclick="start()">Начать охоту</button></div></section>`)}
function start(){s={mission:0,xp:0,secrets:0,paid:false};save();renderMap()}
function renderMap(){shell(`<div class="eyebrow">Маршрут</div><h2>Тайны старой Москвы</h2><div id="map" class="map"></div><div class="map-note">Синяя точка — вы. Золотая — следующая миссия. GPS включается по вашему разрешению.</div><div class="card"><b>Следующая точка</b><h3>${M[s.mission].place}</h3><p>${distanceText()}</p><button class="primary" onclick="openNext()">Открыть миссию</button><button class="secondary" onclick="locate()">Определить моё местоположение</button></div>`);initMap()}
function initMap(){map=L.map("map").setView([55.7539,37.6258],15);L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{attribution:"© OpenStreetMap contributors"}).addTo(map);M.forEach((m,i)=>{if(i<=s.mission+1)L.marker([m.lat,m.lng]).addTo(map).bindPopup(`${m.id}. ${m.place}`)});if(user)L.marker([user.lat,user.lng]).addTo(map).bindPopup("Вы здесь").openPopup()}
function locate(){if(!navigator.geolocation){alert("Геолокация не поддерживается этим браузером.");return}navigator.geolocation.getCurrentPosition(p=>{user={lat:p.coords.latitude,lng:p.coords.longitude};renderMap()},e=>alert("Не удалось получить геолокацию. Проверь разрешение браузера."),{enableHighAccuracy:true,timeout:10000})}
function distanceText(){if(!user)return"Разреши GPS, чтобы увидеть расстояние до точки.";return"До точки примерно "+Math.round(dist(user.lat,user.lng,M[s.mission].lat,M[s.mission].lng)*1000)+" м."}
function dist(a,b,c,d){const R=6371,rad=x=>x*Math.PI/180;const x=rad(c-a),y=rad(d-b);const q=Math.sin(x/2)**2+Math.cos(rad(a))*Math.cos(rad(c))*Math.sin(y/2)**2;return 2*R*Math.asin(Math.sqrt(q))}
function openNext(){if(s.mission>=3&&!s.paid)return paywall();renderMission()}
function renderMission(){const m=M[s.mission];let c=`<div class="eyebrow">Миссия ${m.id}/10 · ${m.place}</div><h1 class="mission-title">${m.title}</h1><div class="progress"><i style="width:${m.id*10}%"></i></div><div class="card"><p class="story">${m.story}</p><p class="question">${m.task}</p>`;if(user)c+=`<div class="status near">📍 ${Math.round(dist(user.lat,user.lng,m.lat,m.lng)*1000)} м до точки</div>`;if(m.kind==="quiz")c+=`<div class="answers">${m.answers.map((a,i)=>`<button class="answer" onclick="answer(${i})">${String.fromCharCode(65+i)} — ${a}</button>`).join("")}</div>`;else if(m.kind==="finish")c+=`<div class="reward"><div class="big">🏆</div><h2>ОХОТНИК ЗА МОСКВОЙ</h2><p>10/10 миссий · ${s.secrets}/2 секрета · ${s.xp} XP</p></div>`;else c+=`<button class="primary" onclick="complete()">Нашёл / Готово</button>`;c+=`</div><button class="secondary" onclick="renderMap()">К карте</button>`;shell(c)}
function answer(i){const m=M[s.mission];if(i!==m.correct){alert("Не угадал. Попробуй ещё раз.");return}complete()}
function complete(){const m=M[s.mission];s.xp+=m.xp;if(m.secret)s.secrets++;s.mission++;save();if(s.mission===3)return paywall();if(s.mission>=10){renderMission();return}renderMap()}
function paywall(){shell(`<div class="eyebrow">Ты прошёл бесплатную часть</div><h1>3/10</h1><p>Ты уже собрал <b>${s.xp} XP</b>. Открой ещё 7 миссий и доберись до финала.</p><div class="card" style="text-align:center"><div class="eyebrow">Полный маршрут</div><div class="price">249 ₽</div><p>7 миссий · 2 секрета · финальный achievement</p><button class="primary" onclick="unlock()">Открыть маршрут</button></div><button class="secondary" onclick="renderMap()">Назад</button>`)}
function unlock(){s.paid=true;save();renderMap()}
function render(){if(s.mission>=10)return renderMission();home()}render();
